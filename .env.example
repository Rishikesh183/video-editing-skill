# Copy to .env (same folder) and fill in. Real environment variables override these.

# Planner used when the app does not choose: claude | codex
HF_PLANNER_PROVIDER=claude
# Claude Code model alias for planning (Pro plan)
HF_PLANNER_MODEL=sonnet
# Codex (ChatGPT plan): a model slug your ChatGPT login offers in Codex (see ~/.codex/models_cache.json)
HF_CODEX_MODEL=gpt-6-sol
HF_CODEX_EFFORT=medium

# Optional: mirror the usage log to Firebase Firestore.
# 1) uv sync --project server --extra firebase
# 2) Firebase console > Project settings > Service accounts > Generate new private key; save the JSON outside the repo
HF_FIREBASE_CREDENTIALS=
HF_FIREBASE_COLLECTION=hf_usage
